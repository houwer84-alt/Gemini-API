# Gemini WebAPI 环境变量配置示例
# 复制此文件为 .env 并填入你的真实值

# Google Gemini Cookies (从浏览器获取)
SECURE_1PSID=your_secure_1psid_value_here
SECURE_1PSIDTS=your_secure_1psidts_value_here

# 代理设置 (可选)
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# Cookie 存储路径 (用于 Docker 等容器环境)
# GEMINI_COOKIE_PATH=/tmp/gemini_webapi

# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
